# Copy these into Hostinger's Node.js app "Environment variables" panel —
# never commit a real .env file or paste real secrets into chat/git.

PORT=3001

# Comma-separated list of frontend origins allowed to call this server.
ALLOWED_ORIGINS=https://new.sbayurveda.com,http://localhost:5173

# Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WooCommerce: wp-admin -> WooCommerce -> Settings -> Advanced -> REST API
# -> Add key (Permissions: Read/Write)
WC_BASE_URL=https://sbayurveda.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Must match the fee shown in the frontend's Checkout page (Cash on Delivery)
COD_FEE=36
