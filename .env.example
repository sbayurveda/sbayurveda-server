# Copy these into Hostinger's Node.js app "Environment variables" panel —
# never commit a real .env file or paste real secrets into chat/git.

PORT=3001

# Comma-separated list of frontend origins allowed to call this server.
ALLOWED_ORIGINS=https://sbayurveda.com,http://localhost:5173

# Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WooCommerce: wp-admin -> WooCommerce -> Settings -> Advanced -> REST API
# -> Add key (Permissions: Read/Write)
# WordPress lives at old.sbayurveda.com after the domain cutover.
WC_BASE_URL=https://old.sbayurveda.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Must match the fee shown in the frontend's Checkout page (Cash on Delivery)
COD_FEE=36

# Flat delivery charge applied below the free-shipping threshold — must match
# the real WooCommerce "Delivery Charges" flat-rate shipping method (India zone).
SHIPPING_FEE=54
FREE_SHIPPING_THRESHOLD=799

# Gmail address + Google App Password (NOT your normal Gmail password —
# generate one at myaccount.google.com/apppasswords with 2FA enabled) used to
# send prescription-upload and doctor-appointment notification emails.
SMTP_USER=sbayurveda4@gmail.com
SMTP_PASS=
# Where those notification emails land — defaults to SMTP_USER if unset.
NOTIFY_TO=sbayurveda4@gmail.com
